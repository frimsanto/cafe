# Salin ke .env lalu sesuaikan nilainya.

# Koneksi PostgreSQL (lokal di VPS, database khusus platform — terpisah dari
# database aplikasi tenant seperti CafeOS).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/platform_admin?schema=public"

# Port HTTP server Express.
# 4000 = fes-backend, 4001 = cafe-backend, 4002 = panel admin ini.
PORT=4002

# Origin frontend yang boleh memanggil API, dipisah koma.
# WAJIB diisi di produksi — panel ini hanya untuk pemilik platform, jadi jangan
# biarkan terbuka untuk semua origin. Kosongkan hanya saat pengembangan lokal.
CORS_ORIGIN="https://admin.fessolution.my.id"
