# Salin ke .env lalu sesuaikan nilainya.
# Koneksi PostgreSQL (lokal di VPS).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Port HTTP server Express.
PORT=4000

# Web Push (VAPID) untuk notifikasi push ke perangkat pelanggan.
# Generate sekali dengan: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Alamat publik aplikasi frontend — dipakai membuat URL di dalam QR code meja.
# WAJIB diisi di produksi, kalau tidak stiker QR akan menunjuk localhost.
PUBLIC_APP_URL="https://cafe.example.com"

# Alamat publik BACKEND — dipakai menyusun URL notifikasi (webhook) Midtrans
# yang ditampilkan di halaman Pengaturan Pembayaran untuk disalin pemilik kafe
# ke dasbor Midtrans-nya.
#
# Kosongkan bila backend berada di domain yang sama dengan frontend: nilainya
# jatuh ke PUBLIC_APP_URL di atas. Isi HANYA bila API dilayani dari host/prefix
# yang berbeda (mis. https://api.cafe.example.com).
PUBLIC_API_URL=""

# JWT untuk endpoint terlindungi. WAJIB diganti dengan nilai acak di produksi.
#
# Sesi memakai dua token: token akses berumur pendek yang ikut di setiap
# permintaan, dan refresh token berumur panjang yang hanya dipakai memanggil
# POST /api/auth/refresh. Umur token akses sengaja pendek — begitu kedaluwarsa
# frontend memperbaruinya sendiri tanpa memaksa pengguna masuk ulang.
#
# JWT_REFRESH_SECRET sebaiknya diisi nilai acak yang BERBEDA dari JWT_SECRET.
# Bila dikosongkan, refresh token ikut memakai JWT_SECRET (tetap aman karena
# jenis token dibedakan lewat klaim `typ`, tapi memisahkannya lebih baik).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary — penyimpanan foto item menu. Ambil dari Dashboard Cloudinary →
# Settings → API Keys. API_SECRET bersifat rahasia: jangan pernah dikirim ke
# frontend dan jangan di-commit.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Kanal pembayaran yang ditawarkan Snap Midtrans (`enabled_payments`).
#
# KOSONGKAN untuk memakai katalog bawaan CafeOS:
#   other_qris, gopay, bca_va, bni_va, echannel
#
# `other_qris` adalah kanal QRIS DINAMIS Midtrans — satu-satunya yang membuat QR
# muncul di Snap pada layar HP. Tanpa nilai itu Midtrans menyembunyikan QRIS di
# perangkat mobile dan hanya menyisakan GoPay/VA. Jangan menggantinya dengan
# `qris`, `QRIS`, atau `qris_dynamic`: ketiganya bukan identifier Snap dan
# diabaikan diam-diam (nilai yang salah TIDAK menimbulkan galat, kanalnya cuma
# hilang).
#
# Isi hanya bila kanal yang ditawarkan perlu diubah untuk SELURUH kafe di server
# ini — mis. menyalakan kartu kredit. Dipisah koma, memakai identifier resmi
# Midtrans (daftar lengkap di backend/src/lib/midtransChannels.ts):
#   MIDTRANS_ENABLED_PAYMENTS="other_qris,gopay,bca_va,bni_va,echannel,credit_card"
#
# Kanal yang belum aktif di akun Midtrans kafe tidak perlu dihilangkan — Snap
# hanya menampilkan yang memang aktif di akun itu.
MIDTRANS_ENABLED_PAYMENTS=""

# DOKU Checkout — gateway pembayaran GLOBAL milik platform (bukan per kafe).
# Berbeda dari Midtrans yang kredensialnya disimpan per kafe di database, DOKU
# memakai satu akun platform: kalau kosong, jalur DOKU otomatis mati untuk semua
# kafe (endpoint /api/pembayaran/doku/* menolak dengan 400).
# Ambil dari Dashboard DOKU → Settings → API Keys.
# DOKU_SECRET_KEY bersifat RAHASIA: tidak pernah dikirim ke frontend — yang
# sampai ke klien hanya `dokuAktif: true/false`.
DOKU_SECRET_KEY=""
DOKU_CLIENT_ID=""
# false = sandbox (api-sandbox.doku.com), true = production (api.doku.com).
DOKU_IS_PRODUCTION=false
# Ke mana pelanggan dikembalikan setelah menyelesaikan pembayaran di DOKU.
# Kosongkan untuk memakai pengaturan redirect di dasbor DOKU.
DOKU_CALLBACK_URL="https://cafe.example.com/status-pembayaran"
# Daftarkan URL notifikasi (webhook) ini di dasbor DOKU:
#   https://cafe.example.com/api/pembayaran/doku/notifikasi

# Kunci enkripsi kredensial pembayaran (mis. Midtrans serverKey) — AES-256-GCM.
# 32 byte dalam bentuk hex (64 karakter). WAJIB diisi di produksi & JANGAN diganti
# setelah ada data terenkripsi (ciphertext lama tak bisa dibuka dengan kunci baru).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# TIDAK ADA kunci cadangan yang dibuat otomatis. Bila variabel ini kosong/salah
# panjang, backend menolak MENYIMPAN kredensial (HTTP 500 dengan pesan
# konfigurasi) dan melaporkan kredensial tersimpan sebagai "tidak bisa dibaca
# server" — bukan menyuruh pemilik kafe mengetik ulang kuncinya.
#
# PM2: environment dibekukan saat aplikasi pertama kali di-start. Setelah
# mengubah .env, `pm2 restart <app>` biasa MEMAKAI ULANG environment lama —
# pakai `pm2 restart <app> --update-env` (atau pm2 delete + pm2 start) supaya
# nilai barunya benar-benar terbawa. Periksa dengan:
#   pm2 env <id> | grep ENCRYPTION_KEY     # cukup lihat ADA/TIDAK, bukan isinya
# Kunci harus SAMA di setiap restart dan setiap instance; kunci yang berganti
# membuat seluruh kredensial tersimpan tidak bisa dibuka lagi.
ENCRYPTION_KEY=""

# ── Penyimpanan foto absensi ─────────────────────────────────────────────────
#
# Direktori tempat foto absen masuk/pulang disimpan. WAJIB DIISI DI PRODUKSI.
#
# Foto absensi adalah data pribadi (wajah karyawan). Karena itu:
#   * Direktorinya HARUS di luar folder aplikasi. Backend MENOLAK menyala di
#     produksi bila jalur ini berada di dalam worktree — berkas di dalam
#     worktree ikut terbawa `git add -A`, muncul di `git status` sebagai berkas
#     yang menggoda untuk di-commit, dan ikut tersalin setiap kali folder
#     proyek disalin.
#   * Direktorinya TIDAK PERNAH disajikan sebagai berkas statis. Tidak ada
#     `express.static` yang menunjuk ke sini, dan tidak boleh ditambahkan.
#     Satu-satunya jalan keluar sebuah foto adalah
#     `GET /api/absensi/foto/:id` — terautentikasi, khusus OWNER, dan disaring
#     `cafeId` dari token. Balasannya `Cache-Control: private, no-store`
#     sehingga proxy bersama maupun disk peramban tidak menyimpan salinannya.
#   * Masa simpannya diatur per kafe (bawaan 90 hari). Retensi menghapus
#     BERKASNYA saja; catatan kehadiran di database tetap ada dan ditandai
#     `dihapus_pada`, karena baris yang lenyap tidak bisa dibedakan dari
#     absensi yang memang tidak pernah berfoto.
#
# Direktorinya dibuat otomatis saat boot dengan mode 0700, dan backend berhenti
# bila tidak bisa dibaca/ditulis. Sertakan dalam cadangan rutin: ini bukti
# kehadiran, bukan berkas sementara.
#
# Contoh produksi (di luar /var/www):
#   ATTENDANCE_PHOTO_DIR=/var/lib/cafeos/absensi
#
# Dikosongkan saat pengembangan → jatuh ke backend/penyimpanan/absensi
# (sudah masuk .gitignore).
ATTENDANCE_PHOTO_DIR=

# ── Origin yang boleh mengirim permintaan ber-cookie ─────────────────────────
#
# Terminal POS diautentikasi lewat cookie HttpOnly, dan cookie dikirim peramban
# secara otomatis. Karena itu daftar origin di bawah bukan kenyamanan melainkan
# batas keamanan: hanya origin di sini yang boleh memanggil API dengan cookie
# terbawa, dan hanya dari sini WebSocket realtime menerima koneksi.
#
# CORS `origin: true` (memantulkan siapa pun yang bertanya) TIDAK dipakai — itu
# akan berarti setiap situs boleh memanggil API ini dengan cookie kasir.
#
# Kosongkan bila PUBLIC_APP_URL dan PUBLIC_API_URL sudah menunjuk ke domain yang
# benar: keduanya otomatis ikut masuk daftar. Isi HANYA bila ada origin lain
# yang sah, mis. domain kedua atau alamat IP tablet saat uji coba di kafe.
# Dipisah koma, lengkap dengan skema dan port:
#   CORS_ORIGINS=https://cafe.example.com,http://192.168.1.20:5173
#
# Saat NODE_ENV bukan production, origin pengembangan (localhost:5173/4173/4000)
# selalu ikut diterima tanpa perlu ditulis di sini.
CORS_ORIGINS=

# Umur sesi kasir di terminal POS. Yang benar-benar mengakhiri sesi adalah
# tombol "Ganti Petugas"; batas ini hanya menjaga terminal yang ditinggalkan
# menyala semalaman tidak tetap terbuka atas nama kasir yang sudah pulang.
POS_SESSION_EXPIRES_IN=14h
