# Salin ke .env lalu sesuaikan nilainya.
# Koneksi PostgreSQL (lokal di VPS).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME?schema=public"

# Port HTTP server Express.
PORT=4000

# Web Push (VAPID) untuk notifikasi push ke perangkat pelanggan.
# Generate sekali dengan: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Alamat publik aplikasi frontend — dipakai membuat URL di dalam QR code meja.
# WAJIB diisi di produksi, kalau tidak stiker QR akan menunjuk localhost.
PUBLIC_APP_URL="https://cafe.example.com"

# JWT untuk endpoint terlindungi. WAJIB diganti dengan nilai acak di produksi.
#
# Sesi memakai dua token: token akses berumur pendek yang ikut di setiap
# permintaan, dan refresh token berumur panjang yang hanya dipakai memanggil
# POST /api/auth/refresh. Umur token akses sengaja pendek — begitu kedaluwarsa
# frontend memperbaruinya sendiri tanpa memaksa pengguna masuk ulang.
#
# JWT_REFRESH_SECRET sebaiknya diisi nilai acak yang BERBEDA dari JWT_SECRET.
# Bila dikosongkan, refresh token ikut memakai JWT_SECRET (tetap aman karena
# jenis token dibedakan lewat klaim `typ`, tapi memisahkannya lebih baik).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary — penyimpanan foto item menu. Ambil dari Dashboard Cloudinary →
# Settings → API Keys. API_SECRET bersifat rahasia: jangan pernah dikirim ke
# frontend dan jangan di-commit.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# DOKU Checkout — gateway pembayaran GLOBAL milik platform (bukan per kafe).
# Berbeda dari Midtrans yang kredensialnya disimpan per kafe di database, DOKU
# memakai satu akun platform: kalau kosong, jalur DOKU otomatis mati untuk semua
# kafe (endpoint /api/pembayaran/doku/* menolak dengan 400).
# Ambil dari Dashboard DOKU → Settings → API Keys.
# DOKU_SECRET_KEY bersifat RAHASIA: tidak pernah dikirim ke frontend — yang
# sampai ke klien hanya `dokuAktif: true/false`.
DOKU_SECRET_KEY=""
DOKU_CLIENT_ID=""
# false = sandbox (api-sandbox.doku.com), true = production (api.doku.com).
DOKU_IS_PRODUCTION=false
# Ke mana pelanggan dikembalikan setelah menyelesaikan pembayaran di DOKU.
# Kosongkan untuk memakai pengaturan redirect di dasbor DOKU.
DOKU_CALLBACK_URL="https://cafe.example.com/status-pembayaran"
# Daftarkan URL notifikasi (webhook) ini di dasbor DOKU:
#   https://cafe.example.com/api/pembayaran/doku/notifikasi

# Kunci enkripsi kredensial pembayaran (mis. Midtrans serverKey) — AES-256-GCM.
# 32 byte dalam bentuk hex (64 karakter). WAJIB diisi di produksi & JANGAN diganti
# setelah ada data terenkripsi (ciphertext lama tak bisa dibuka dengan kunci baru).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
