{
  // Pemeriksaan tipe untuk berkas uji.
  //
  // Vitest menjalankannya sebagai ESM, jadi `await import()` di tingkat atas
  // sah di sini — sesuatu yang tidak berlaku pada build CommonJS di
  // `tsconfig.json`. Dipisah supaya keduanya tidak saling memaksa berkompromi:
  // produksi tetap CommonJS, uji tetap bisa memakai bentuk yang dijalankan
  // Vitest sungguhan.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
