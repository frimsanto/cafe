// CafeOS — skema database (Prisma / PostgreSQL).
// Fase 1 backend: domain Menu Digital & Pemesanan (menu, pesanan, pembayaran).
//
// Multi-tenant: setiap baris data tenant membawa `cafeId` untuk isolasi data
// antar kafe. Tabel `users`/auth menyusul pada fase Autentikasi & Multi-Tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

/// Status KASAR sebuah pesanan. Rinciannya ada di tiga kolom yang terpisah —
/// `status_pembayaran` (uang), `kitchen_status` (dapur), dan `fulfillment_type`
/// (cara disajikan); enum ini hanya penanda babak besarnya.
///
/// `DIBATALKAN` ditambahkan migrasi `20260831000000_tambah_status_dibatalkan`
/// lewat `ALTER TYPE ... ADD VALUE` (aditif, tidak menyentuh baris lama).
enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  DIPROSES_DAPUR
  SELESAI
  DIBATALKAN
}

enum KitchenStatus {
  WAITING
  COOKING
  READY
}

enum PaymentMethod {
  QRIS
  GOPAY
  CARD
  CASH
  EDC
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Peran staf dalam sebuah kafe.
enum Role {
  OWNER
  KASIR
  DAPUR
}

/// Mode akun Midtrans. Kredensial kedua mode disimpan TERPISAH (baris berbeda
/// di `midtrans_credentials`) supaya kunci Sandbox tidak pernah bisa dipakai
/// sebagai cadangan Production — uang sungguhan tidak boleh bergantung pada
/// kunci uji coba.
enum MidtransMode {
  SANDBOX
  PRODUCTION
}

/// Kanal tempat sebuah metode pembayaran manual boleh muncul.
enum KanalPembayaran {
  /// Layar kasir (POS) — dioperasikan staf.
  KASIR
  /// Checkout mandiri di HP pelanggan.
  CHECKOUT
}

/// Keputusan kasir atas sebuah pembayaran manual.
enum StatusVerifikasi {
  MENUNGGU
  DITERIMA
  DITOLAK
}

// ── Tenant ───────────────────────────────────────────────────────────────────

model Cafe {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Konfigurasi pembayaran per kafe — KOLOM CERMIN, jangan dibaca lagi ──────
  //
  // Sumber kebenarannya kini `metode_pembayaran_kafe` & `midtrans_credentials`.
  // Kolom di bawah TETAP DIPELIHARA `paymentSettings.service` supaya penurunan
  // versi aplikasi (rollback kode tanpa rollback database) masih menemukan
  // konfigurasi yang benar. Kode baru TIDAK boleh membacanya — `midtransAktif`
  // khususnya menyesatkan: ia cuma berarti "pernah ada Server Key", bukan "siap
  // menerima uang".
  //
  // `midtransProduction` adalah MODE AKTIF kafe (sandbox/production) — satu-
  // satunya kolom lama yang masih ikut menentukan perilaku, dan dibaca lewat
  // `paymentSettings.service`, bukan langsung.
  metodeDiterima     String[] @default(["TUNAI"]) @map("metode_diterima")
  midtransServerKey  String?  @map("midtrans_server_key")
  midtransClientKey  String?  @map("midtrans_client_key")
  midtransProduction Boolean  @default(false) @map("midtrans_production")
  midtransAktif      Boolean  @default(false) @map("midtrans_aktif")

  // ── Pengaturan operasional ─────────────────────────────────────────────────
  //
  // Sebelum kolom-kolom ini ada, seluruh perhitungan tanggal memakai waktu
  // LOKAL SERVER (lihat `lib/period.ts` yang lama). Itu diam-diam benar selama
  // server dan kafe kebetulan berada di zona yang sama, dan diam-diam salah
  // pada dua hal yang justru paling sering ditanyakan pemilik: omzet "hari ini"
  // untuk kafe yang tutup pukul 2 pagi, dan shift yang melewati tengah malam.

  /// Zona waktu kafe (IANA, mis. "Asia/Jakarta"). SELURUH laporan, batas hari,
  /// dan perhitungan jadwal memakai ini — bukan zona waktu server.
  timezone String @default("Asia/Jakarta")

  /// Menit dari tengah malam tempat HARI OPERASIONAL berganti (0-1439).
  ///
  /// Kafe yang tutup pukul 02:00 ingin penjualan pukul 01:30 masuk ke omzet
  /// "kemarin", karena begitulah kasirnya menutup laci. Nilai 0 = hari
  /// operasional sama dengan hari kalender.
  awalHariOperasional Int @default(0) @map("awal_hari_operasional")

  /// Awal minggu untuk laporan mingguan (ISO 1-7; 1 = Senin).
  awalMinggu Int @default(1) @map("awal_minggu")

  /// Berapa lama foto absensi disimpan sebelum boleh dihapus. Catatan
  /// kehadirannya sendiri tidak pernah ikut terhapus.
  retensiFotoHari Int @default(90) @map("retensi_foto_hari")

  /// Apakah kasir boleh melihat riwayat transaksinya di luar shift berjalan.
  kasirLihatRiwayat Boolean @default(true) @map("kasir_lihat_riwayat")

  /// Pengganti boleh mulai bekerja sambil menunggu persetujuan pemilik.
  /// False = penggantian harus disetujui LEBIH DULU.
  penggantiBolehLangsung Boolean @default(true) @map("pengganti_boleh_langsung")

  users                User[]
  categories           MenuCategory[]
  menuItems            MenuItem[]
  tables               Table[]
  orders               Order[]
  pushSubscriptions    PushSubscription[]
  dashboardPreferences DashboardPreference[]
  metodePembayaran     MetodePembayaranKafe[]
  midtransCredentials  MidtransCredential[]
  paymentAuditLogs     PaymentAuditLog[]
  webhookEvents        GatewayWebhookEvent[]
  shiftTemplates       ShiftTemplate[]
  shiftSchedules       ShiftSchedule[]
  cashierDevices       CashierDevice[]
  attendanceRecords    AttendanceRecord[]
  attendancePhotos     AttendancePhoto[]
  cashierShifts        CashierShift[]
  cashMovements        CashMovement[]
  shiftReplacements    ShiftReplacement[]

  @@map("cafes")
}

// ── Pengguna (staf & pemilik) ────────────────────────────────────────────────

model User {
  id           String @id @default(uuid()) @db.Uuid
  cafeId       String @map("cafe_id") @db.Uuid
  name         String
  // Email unik lintas sistem — dipakai sebagai identitas login.
  email        String @unique
  // Hanya hash yang disimpan; kata sandi mentah tidak pernah masuk database.
  passwordHash String @map("password_hash")
  role         Role   @default(OWNER)

  /// Nomor HP staf — dipakai pemilik untuk menghubungi, bukan untuk login.
  phone String?

  /// Staf yang dinonaktifkan tidak bisa masuk dan tidak muncul di layar
  /// pergantian petugas, TAPI seluruh riwayat transaksinya tetap utuh.
  /// Dibedakan dari `deletedAt`: yang ini bisa dinyalakan lagi besok.
  aktif Boolean @default(true)

  // ── PIN perangkat POS ──────────────────────────────────────────────────────
  //
  // PIN 4-6 digit untuk membuka sesi kasir di terminal bersama — BUKAN
  // pengganti kata sandi, dan tidak pernah bisa dipakai di halaman login biasa.
  // Ruang tebakannya kecil (sejuta kemungkinan pada 6 digit, sepuluh ribu pada
  // 4), jadi yang menjaganya bukan panjang PIN-nya melainkan penguncian
  // sementara di bawah: menebak habis-habisan menjadi mustahil karena
  // percobaannya yang dibatasi, bukan karena PIN-nya yang sulit.
  //
  // Di-hash dengan bcrypt, algoritma yang sama dengan `passwordHash` — tidak
  // ada tempat kedua yang perlu diperiksa saat kelak biayanya dinaikkan.

  /// Hash bcrypt PIN. Null = staf ini belum punya PIN.
  pinHash String? @map("pin_hash")

  pinDiperbaruiPada DateTime? @map("pin_diperbarui_pada")

  /// Percobaan gagal BERUNTUN. Direset menjadi 0 begitu PIN benar.
  pinGagal Int @default(0) @map("pin_gagal")

  /// Penguncian sementara setelah percobaan gagal berulang.
  pinTerkunciSampai DateTime? @map("pin_terkunci_sampai")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  cafe                Cafe                 @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  dashboardPreference DashboardPreference?
  jadwal              ShiftSchedule[]      @relation("JadwalStaf")
  absensi             AttendanceRecord[]   @relation("AbsensiStaf")
  shiftKasir          CashierShift[]       @relation("ShiftKasir")
  digantikan          ShiftReplacement[]   @relation("PenggantiDigantikan")
  menggantikan        ShiftReplacement[]   @relation("PenggantiMenggantikan")
  // Pesanan yang ditagih & yang dibatalkan staf ini. `onDelete: SetNull` di sisi
  // `Order`: menghapus seorang kasir tidak boleh ikut menghapus riwayat
  // penjualan, tapi jejaknya juga tidak boleh menunjuk baris yang sudah tiada.
  ordersAsCashier     Order[]              @relation("OrderCashier")
  ordersCancelled     Order[]              @relation("OrderCancelledBy")

  @@index([cafeId])
  @@map("users")
}

// ── Meja ─────────────────────────────────────────────────────────────────────

model Table {
  id        String    @id @default(uuid()) @db.Uuid
  cafeId    String    @map("cafe_id") @db.Uuid
  tableName String    @map("table_name")
  // Referensi/token unik yang dienkode ke QR code meja.
  qrCode    String    @unique @map("qr_code")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  cafe   Cafe    @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  orders Order[]

  // CATATAN: unik nama meja per kafe (abaikan besar-kecil huruf, hanya baris
  // hidup) berupa PARTIAL UNIQUE INDEX di migrasi
  // `20260724060000_table_management_constraints` — Prisma belum bisa
  // menyatakannya di schema. Jangan hapus saat `prisma migrate dev`.
  @@index([cafeId])
  @@map("tables")
}

// ── Menu ─────────────────────────────────────────────────────────────────────

model MenuCategory {
  id            String    @id @default(uuid()) @db.Uuid
  cafeId        String    @map("cafe_id") @db.Uuid
  name          String
  orderPosition Int       @default(0) @map("order_position")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  cafe  Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  items MenuItem[]
  // CATATAN: unik nama kategori per kafe (abaikan besar-kecil huruf, hanya
  // baris hidup) dipasang sebagai PARTIAL UNIQUE INDEX lewat SQL mentah di
  // migrasi `20260724050000_menu_management_constraints` — Prisma belum bisa
  // menyatakan index parsial/ekspresi di schema. Jangan hapus index itu saat
  // menjalankan `prisma migrate dev`.

  @@index([cafeId])
  // Urutan tampil kategori pada menu pelanggan & halaman manajemen menu.
  @@index([cafeId, orderPosition])
  @@map("menu_categories")
}

model MenuItem {
  id          String    @id @default(uuid()) @db.Uuid
  cafeId      String    @map("cafe_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String
  description String    @default("")
  price       Decimal   @db.Decimal(12, 2)
  imageUrl    String    @default("") @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  cafe       Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  // CATATAN: unik nama item per kategori (abaikan besar-kecil huruf, hanya
  // baris hidup) juga berupa partial unique index di migrasi yang sama.

  @@index([cafeId])
  @@index([categoryId])
  // Menu pelanggan hanya menampilkan item yang tersedia.
  @@index([cafeId, isAvailable])
  @@map("menu_items")
}

// ── Pesanan ──────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  cafeId      String      @map("cafe_id") @db.Uuid
  /// NULL hanya untuk pesanan bawa pulang: tidak ada meja yang bisa disebut,
  /// dan menautkannya ke meja mana pun akan membuat meja itu tampak terisi.
  /// Pesanan makan di tempat WAJIB punya meja — dijaga di service, bukan di
  /// database, karena aturannya bergantung pada `fulfillment_type`.
  tableId     String?     @map("table_id") @db.Uuid
  status      OrderStatus @default(MENUNGGU_PEMBAYARAN)
  totalAmount Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)

  // ── Bentuk pesanan ─────────────────────────────────────────────────────────
  /// DINE_IN | TAKEAWAY — lihat `lib/orderStatus.ts`.
  fulfillmentType String  @default("DINE_IN") @map("fulfillment_type")
  /// TABLE_QR | CASHIER — dari mana pesanan ini lahir. Menentukan apakah ia
  /// perlu dikonfirmasi kasir dan bagaimana ia ditandai di Layar Dapur.
  orderSource     String  @default("TABLE_QR") @map("order_source")
  /// Nama tamu, bila kasir sempat menanyakannya. Tidak pernah wajib.
  customerName    String? @map("customer_name")
  /// Catatan untuk SELURUH pesanan (mis. "pisahkan piringnya"). Catatan per
  /// item tetap di `order_items.notes`.
  catatan         String?

  // ── Perjalanan di dapur ────────────────────────────────────────────────────
  /// NOT_SENT | QUEUED | PREPARING | READY | COMPLETED.
  ///
  /// TEKS, sealasan `status_pembayaran`: menambah tahap baru tidak boleh
  /// menuntut migrasi tipe yang mengunci tabel pesanan. Status per-item
  /// (`order_items.kitchen_status`) tetap ada dan dipelihara bersamaan —
  /// yang di sini mengikuti tiketnya, yang di sana mengikuti barisnya.
  kitchenStatus    String    @default("NOT_SENT") @map("kitchen_status")
  kitchenQueuedAt  DateTime? @map("kitchen_queued_at")
  kitchenStartedAt DateTime? @map("kitchen_started_at")
  kitchenReadyAt   DateTime? @map("kitchen_ready_at")
  completedAt      DateTime? @map("completed_at")

  // ── Jejak keputusan kasir ──────────────────────────────────────────────────
  /// Kasir/pemilik yang membuat pesanan ini di layar kasir (jalur POS).
  cashierUserId    String?   @map("cashier_user_id") @db.Uuid
  confirmedAt      DateTime? @map("confirmed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelledBy      String?   @map("cancelled_by") @db.Uuid
  /// Wajib terisi saat dibatalkan — pembatalan tanpa alasan tidak bisa
  /// dipertanggungjawabkan besok.
  alasanPembatalan String?   @map("alasan_pembatalan")

  /// Shift kasir yang bertanggung jawab atas uang pesanan ini.
  ///
  /// NULL itu SAH dan punya dua arti berbeda yang keduanya benar:
  ///   - Pesanan lama, dibuat sebelum modul shift ada. Ditandai "Data lama"
  ///     di laporan, bukan disembunyikan.
  ///   - Pesanan yang dibayar sendiri oleh tamu lewat gateway (Midtrans) dari
  ///     meja. Tidak ada kasir yang menerimanya, jadi mengaitkannya ke sebuah
  ///     shift justru akan membuat rekap tunai shift itu salah.
  cashierShiftId String? @map("cashier_shift_id") @db.Uuid

  /// Terminal tempat transaksi ini diproses. NULL untuk jalur non-kasir.
  deviceId String? @map("device_id") @db.Uuid

  /// Kunci anti-kirim-ganda untuk pesanan yang dibuat di layar kasir.
  ///
  /// Kasir menekan "Bayar & Kirim ke Dapur" dua kali (atau jaringannya lambat
  /// lalu ia mengulang) tidak boleh melahirkan dua tagihan. Unique constraint
  /// parsial `(cafe_id, idempotency_key)` yang menjadi penengahnya — yang kedua
  /// kalah di database, bukan di logika aplikasi yang bisa balapan.
  idempotencyKey String? @map("idempotency_key")

  // Ringkasan pembayaran yang disalin dari baris `payments` saat pesanan
  // dirilis ke dapur. Sumber kebenaran tetap tabel `payments`; salinan di sini
  // membuat laporan bisa menyaring "kapan uangnya masuk" tanpa join, dan
  // memperbaiki omzet harian yang sebelumnya memakai waktu pesanan dibuat.
  paymentMethod PaymentMethod? @map("payment_method")
  paidAt        DateTime?      @map("paid_at")

  // ── Integrasi pembayaran dua jalur ─────────────────────────────────────────
  // Diisi jalur Midtrans: `order_id` yang dikirim ke Snap + token transaksinya.
  midtransOrderId   String?  @map("midtrans_order_id")
  snapToken         String?  @map("snap_token")
  // Diisi jalur DOKU Checkout: `invoice_number` yang dikirim ke DOKU. Jadi kunci
  // pencocokan saat notifikasi (webhook) datang, sebagaimana `midtransOrderId`.
  dokuInvoiceNumber String?  @map("doku_invoice_number")
  // Status pembayaran domain (TEKS, lintas jalur manual & gateway). Kosakata
  // kanoniknya ada di `lib/paymentStatus.ts`: UNPAID | AWAITING_VERIFICATION |
  // PAID | FAILED | EXPIRED | CANCELLED | REFUNDED | PARTIALLY_REFUNDED.
  //
  // Sengaja TEKS, bukan enum PostgreSQL: menambah status baru tidak boleh
  // menuntut migrasi tipe yang mengunci tabel pesanan. Baris lama berkosakata
  // Indonesia (MENUNGGU/LUNAS/GAGAL) dipetakan migrasi
  // `20260830000000_pengaturan_pembayaran`, dan `normalisasiStatus()` tetap
  // menerimanya agar klien lama tidak patah.
  //
  // BUKAN status pesanan/dapur — itu `status` (OrderStatus) di atas.
  statusPembayaran  String?  @default("UNPAID") @map("status_pembayaran")
  // Metode aktual yang menuntaskan pembayaran — kode manual (TUNAI/QRIS_STATIS/
  // TRANSFER/EDC) atau label Midtrans (QRIS/GoPay/BCA Virtual Account/…).
  metodePembayaran  String?  @map("metode_pembayaran")
  // Nominal yang disepakati saat lunas (tagihan yang dibayar).
  nominalDibayar    Decimal? @map("nominal_dibayar") @db.Decimal(12, 2)

  // Nomor antrian yang dipanggil ke tamu, ditampilkan sebagai `A-001`.
  // Berurutan per kafe DAN per hari: pesanan pertama hari itu selalu 1, lalu
  // naik sampai 999 sebelum berputar kembali ke 1. Null hanya pada pesanan
  // lama yang dibuat sebelum kolom ini ada.
  queueNumber Int? @map("queue_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe              Cafe               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table             Table?             @relation(fields: [tableId], references: [id], onDelete: Restrict)
  cashier           User?              @relation("OrderCashier", fields: [cashierUserId], references: [id], onDelete: SetNull)
  cashierShift      CashierShift?      @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)
  pembatal          User?              @relation("OrderCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payment           Payment?
  pembayaranManual  PembayaranManual?
  pushSubscriptions PushSubscription[]

  // Anti-kirim-ganda pesanan kasir. NULL dianggap berbeda satu sama lain oleh
  // PostgreSQL, jadi pesanan dari QR (yang tidak punya kunci) tidak terganggu.
  @@unique([cafeId, idempotencyKey])
  @@index([cafeId])
  @@index([tableId])
  @@index([cafeId, status])
  @@index([createdAt])
  // Laporan omzet menyaring berdasarkan kapan pesanan DIBAYAR.
  @@index([cafeId, paidAt])
  // Layar kasir: tab "Perlu Konfirmasi"/"Sudah Dibayar" menyaring status bayar.
  // Pengurutan per waktu sudah tertutup index `[cafeId, createdAt, queueNumber]`
  // di bawah — PostgreSQL memakai awalannya, jadi tidak perlu index kembar.
  @@index([cafeId, statusPembayaran])
  // Layar Dapur & tab "Sedang Diproses" menyaring tahap dapur.
  @@index([cafeId, kitchenStatus])
  // Filter "QR Meja / Kasir" di header layar kasir.
  @@index([cafeId, orderSource])
  // Pencarian pesanan dari webhook / polling Midtrans lewat order_id gateway.
  @@index([midtransOrderId])
  // Pencarian pesanan dari webhook DOKU lewat invoice_number.
  @@index([dokuInvoiceNumber])
  // Mencari nomor antrian tertinggi milik kafe ini pada hari berjalan.
  @@index([cafeId, createdAt, queueNumber])
  // Rekap penutupan shift menjumlahkan transaksi MILIK shift itu.
  @@index([cashierShiftId])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  menuItemId    String        @map("menu_item_id") @db.Uuid
  // Snapshot nama & harga saat dipesan (tahan perubahan menu di kemudian hari).
  name          String
  price         Decimal       @db.Decimal(12, 2)
  quantity      Int           @default(1)
  notes         String        @default("")
  kitchenStatus KitchenStatus @default(WAITING) @map("kitchen_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  // Mendukung query/agregasi status masak untuk Layar Dapur (KDS) & dasbor.
  @@index([kitchenStatus])
  @@map("order_items")
}

// ── Pembayaran ───────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @unique @map("order_id") @db.Uuid
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  // ID transaksi dari gateway eksternal (mis. QRIS). Null saat masih PENDING.
  transactionId String?       @map("transaction_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

/// Satu pembayaran manual (tunai / QRIS statis / transfer / EDC) beserta jejak
/// verifikasinya. Melengkapi jalur Midtrans; satu baris per pesanan.
///
/// Barisnya bisa lahir dari DUA arah:
///   - Pelanggan memilih metode manual di checkout -> `sumber = CHECKOUT`,
///     `statusVerifikasi = MENUNGGU`. Uang BELUM diterima; pesanan berstatus
///     bayar `AWAITING_VERIFICATION` sampai kasir memutuskan.
///   - Kasir menagih langsung di layar kasir -> `sumber = KASIR` dan langsung
///     `DITERIMA` (kasirnya sendiri yang memegang uangnya).
///
/// Yang membuat baris ini bukan sekadar catatan: setiap keputusan menyimpan
/// SIAPA yang memutuskan dan KAPAN, sehingga selisih kas punya jejak yang bisa
/// ditelusuri. Alasan penolakan wajib ada agar tamu bisa diberi tahu kenapa.
model PembayaranManual {
  id           String   @id @default(cuid())
  orderId      String   @unique @map("order_id") @db.Uuid
  // Kode metode manual: TUNAI, QRIS_STATIS, TRANSFER, EDC.
  metode       String
  // Nominal yang diterima kasir (untuk tunai bisa > total -> menghitung kembalian).
  nominal      Decimal  @db.Decimal(12, 2)
  catatanKasir String?  @map("catatan_kasir")
  createdAt    DateTime @default(now()) @map("created_at")

  // -- Alur verifikasi --------------------------------------------------------
  /// Dari mana permintaan pembayaran ini datang.
  sumber           KanalPembayaran  @default(KASIR)
  statusVerifikasi StatusVerifikasi @default(DITERIMA) @map("status_verifikasi")
  /// Kasir/pemilik yang menerima atau menolak. Null pada permintaan yang masih
  /// menunggu, dan pada baris lama sebelum kolom ini ada.
  diverifikasiOleh String?          @map("diverifikasi_oleh") @db.Uuid
  diverifikasiPada DateTime?        @map("diverifikasi_pada")
  /// Wajib terisi saat DITOLAK - tamu berhak tahu alasannya.
  alasanPenolakan  String?          @map("alasan_penolakan")
  /// Nomor referensi/approval (transfer, EDC) yang dicatat kasir.
  referensi        String?
  /// Bukti pembayaran yang diunggah (Cloudinary, folder per kafe).
  buktiUrl         String?          @map("bukti_url")
  buktiPublicId    String?          @map("bukti_public_id")
  /// Shift & terminal yang memproses keputusan ini — disalin dari sesi kasir,
  /// tidak pernah dari body permintaan.
  cashierShiftId   String?          @map("cashier_shift_id") @db.Uuid
  deviceId         String?          @map("device_id") @db.Uuid
  updatedAt        DateTime         @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Antrean "perlu diverifikasi" di layar kasir menyaring kolom ini.
  @@index([statusVerifikasi])
  @@map("pembayaran_manual")
}

// -- Pengaturan pembayaran per kafe -------------------------------------------

/// Konfigurasi SATU metode pembayaran manual milik sebuah kafe.
///
/// Menggantikan array `cafes.metode_diterima` yang hanya bisa menyimpan "aktif
/// atau tidak": sebuah metode sekarang punya kanal (kasir/checkout), kewajiban
/// verifikasi, dan rinciannya sendiri (gambar QRIS, nomor rekening, terminal
/// EDC). Kolom lama tetap dipelihara sebagai cermin - lihat komentarnya di
/// model `Cafe`.
///
/// Rincian rekening & QRIS adalah data tenant: tidak pernah keluar dari
/// endpoint mana pun tanpa `cafeId` dari token.
model MetodePembayaranKafe {
  id     String @id @default(uuid()) @db.Uuid
  cafeId String @map("cafe_id") @db.Uuid
  /// Kode metode: TUNAI | QRIS_STATIS | TRANSFER | EDC.
  metode String

  aktif                Boolean @default(false)
  /// Muncul di layar kasir (POS).
  tersediaDiKasir      Boolean @default(true) @map("tersedia_di_kasir")
  /// Muncul di checkout mandiri pelanggan. EDC & Tunai selalu false -
  /// keduanya menuntut kehadiran kasir.
  tersediaDiCheckout   Boolean @default(false) @map("tersedia_di_checkout")
  /// Pembayaran lewat metode ini harus dikonfirmasi kasir sebelum dianggap
  /// lunas. Dipaksa true untuk metode yang tampil di checkout.
  wajibVerifikasiKasir Boolean @default(true) @map("wajib_verifikasi_kasir")

  /// Instruksi bebas yang ditampilkan ke pelanggan/kasir.
  instruksi       String?
  /// Batas waktu pembayaran dalam menit (transfer bank). Null = tanpa batas.
  batasWaktuMenit Int?    @map("batas_waktu_menit")

  // -- QRIS statis --
  qrisImageUrl      String? @map("qris_image_url")
  qrisImagePublicId String? @map("qris_image_public_id")
  qrisMerchantName  String? @map("qris_merchant_name")
  qrisNmid          String? @map("qris_nmid")

  // -- Transfer bank --
  bankNama          String? @map("bank_nama")
  bankNomorRekening String? @map("bank_nomor_rekening")
  bankAtasNama      String? @map("bank_atas_nama")

  // -- EDC --
  edcProvider      String? @map("edc_provider")
  edcTerminalLabel String? @map("edc_terminal_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, metode])
  @@index([cafeId])
  @@map("metode_pembayaran_kafe")
}

/// Kredensial Midtrans milik sebuah kafe, SATU BARIS PER MODE.
///
/// Memisahkan Sandbox dari Production adalah inti model ini: dengan satu slot
/// bersama (skema lama), menyalakan Production tanpa mengganti kunci berarti
/// transaksi uang sungguhan dikirim memakai kunci uji coba. Di sini kunci
/// Production hanya ada bila memang pernah diisi - tidak ada jalan mundur ke
/// kunci Sandbox.
///
/// `serverKeyEnc` disimpan TERENKRIPSI (AES-256-GCM, `lib/enkripsi.ts`, kunci
/// dari `ENCRYPTION_KEY` di environment) dan TIDAK PERNAH dikembalikan ke klien
/// dalam bentuk apa pun. `clientKey` memang publik (dipakai Snap.js di
/// browser), jadi aman diekspos - tetap hanya ke kafe pemiliknya.
model MidtransCredential {
  id     String       @id @default(uuid()) @db.Uuid
  cafeId String       @map("cafe_id") @db.Uuid
  mode   MidtransMode

  clientKey     String? @map("client_key")
  serverKeyEnc  String? @map("server_key_enc")
  /// 4 karakter terakhir Server Key - supaya pemilik bisa memastikan kunci
  /// mana yang tersimpan tanpa kuncinya pernah dikirim balik.
  serverKeyHint String? @map("server_key_hint")

  /// BELUM_DIUJI | BERHASIL | GAGAL - hasil tombol "Tes Koneksi".
  statusKoneksi    String    @default("BELUM_DIUJI") @map("status_koneksi")
  koneksiDiperiksa DateTime? @map("koneksi_diperiksa")
  /// Pesan ringkas hasil tes (mis. "401 Unauthorized"). TIDAK PERNAH memuat kunci.
  koneksiPesan     String?   @map("koneksi_pesan")

  /// BELUM_DIPERIKSA | TERVERIFIKASI | GAGAL - apakah notifikasi Midtrans
  /// pernah benar-benar masuk dengan signature yang cocok pada mode ini.
  statusWebhook    String    @default("BELUM_DIPERIKSA") @map("status_webhook")
  webhookDiperiksa DateTime? @map("webhook_diperiksa")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, mode])
  @@index([cafeId])
  @@map("midtrans_credentials")
}

/// Jejak audit perubahan & keputusan pembayaran.
///
/// ATURAN KERAS: tidak ada rahasia yang boleh masuk ke sini. `nilaiLama`/
/// `nilaiBaru` hanya menerima nilai yang aman dibaca ulang (nama metode, mode,
/// status) - Server Key, ciphertext-nya, dan nomor rekening lengkap tidak
/// pernah ikut. Penyaringnya ada di `lib/auditRedaksi.ts`.
model PaymentAuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  cafeId      String  @map("cafe_id") @db.Uuid
  /// Pelaku. Null untuk tindakan sistem (webhook gateway).
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorRole   String? @map("actor_role")
  /// Kode aksi, mis. `metode.diperbarui`, `midtrans.kredensial.disimpan`,
  /// `pembayaran.manual.ditolak`.
  aksi        String
  /// Pesanan terkait, bila aksinya menyangkut satu pesanan.
  orderId     String? @map("order_id") @db.Uuid
  nilaiLama   Json?   @map("nilai_lama")
  nilaiBaru   Json?   @map("nilai_baru")
  ip          String?
  userAgent   String? @map("user_agent")

  // ── Perluasan: dari jejak pembayaran menjadi jejak audit umum ──────────────
  //
  // Nama tabelnya TETAP `payment_audit_logs`. Mengganti nama tabel yang sudah
  // berisi data hanya untuk memperbaiki namanya adalah migrasi berisiko yang
  // tidak membeli apa pun; yang bertambah cuma kolom, dan seluruh baris lama
  // tetap terbaca persis seperti sebelumnya. Aksi shift/absensi/staf memakai
  // tabel yang sama supaya "apa yang terjadi pada pesanan ini" dan "siapa yang
  // membuka laci saat itu" bisa dibaca dalam SATU urutan waktu.

  /// Jenis entitas yang disentuh: `order`, `cashier_shift`, `attendance`,
  /// `user`, `shift_schedule`, `cashier_device`, `cash_movement`.
  /// Null pada baris lama yang selalu menyangkut pesanan.
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  /// Alasan yang ditulis manusia — wajib untuk pembatalan, penolakan,
  /// pengecualian foto, dan koreksi pemilik.
  alasan String?

  /// Terminal tempat aksi terjadi, bila ada.
  deviceId String? @map("device_id") @db.Uuid

  /// Penanda satu alur permintaan — menyatukan beberapa baris audit yang lahir
  /// dari satu ketukan tombol.
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, createdAt])
  @@index([orderId])
  @@index([entityType, entityId])
  @@map("payment_audit_logs")
}

/// Notifikasi gateway yang SUDAH diproses - kunci idempotensi webhook.
///
/// Midtrans mengirim ulang notifikasi yang sama sampai menerima 200, dan bisa
/// mengirim beberapa sekaligus. Tanpa tabel ini, dua notifikasi kembar yang
/// tiba bersamaan sama-sama lolos pemeriksaan "sudah lunas belum" lalu
/// sama-sama menulis - menerbitkan tiket dapur ganda. Unique constraint di
/// `(gateway, event_key)` yang menjadi penengahnya: yang kedua kalah di
/// database, bukan di logika aplikasi yang bisa balapan.
model GatewayWebhookEvent {
  id       String @id @default(uuid()) @db.Uuid
  cafeId   String @map("cafe_id") @db.Uuid
  /// `midtrans` | `doku`.
  gateway  String
  /// Identitas unik satu notifikasi: `<order_id>:<transaction_status>:<status_code>`.
  eventKey String @map("event_key")

  orderId           String?  @map("order_id") @db.Uuid
  transactionStatus String?  @map("transaction_status")
  /// Nominal yang diklaim notifikasi - disimpan untuk penelusuran selisih.
  grossAmount       Decimal? @map("gross_amount") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([gateway, eventKey])
  @@index([cafeId, createdAt])
  @@map("gateway_webhook_events")
}

// ── Preferensi tampilan dasbor ───────────────────────────────────────────────

model DashboardPreference {
  id      String @id @default(uuid()) @db.Uuid
  cafeId  String @map("cafe_id") @db.Uuid
  // Pemilik preferensi — satu baris per pengguna.
  userId  String @unique @map("user_id") @db.Uuid
  // Peta widget → tampil/sembunyi, mis. {"revenue":true,"topMenu":false}.
  // Disimpan sebagai JSON agar widget baru tidak memerlukan migrasi kolom.
  widgets Json   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cafeId])
  @@map("dashboard_preferences")
}

// ── Langganan Push (Web Push / VAPID) ────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  cafeId    String   @map("cafe_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  // Data langganan dari browser (PushSubscription API).
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  cafe  Cafe  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("push_subscriptions")
}

// ── Pendaftaran tenant (calon kafe) ──────────────────────────────────────────

/// Permintaan pendaftaran dari formulir publik `/daftar`.
///
/// Baris di sini BUKAN akun: tidak ada `cafes` maupun `users` yang lahir
/// darinya. Kafe baru hanya boleh aktif setelah admin menindaklanjuti
/// pendaftarannya — panel super admin (fessolution.my.id) membaca tabel yang
/// sama lewat koneksi terpisah dan menaikkan statusnya dari sana.
///
/// CATATAN NAMA KOLOM: `nama_bisnis` dan `jenis_aplikasi` mengikuti kontrak
/// panel super admin yang melayani beberapa aplikasi sekaligus — jangan
/// diganti menjadi `nama_cafe` tanpa mengubah panel itu juga, karena query-nya
/// menyebut kolom ini secara eksplisit.
model TenantRegistration {
  id            String   @id @default(uuid()) @db.Uuid
  namaBisnis    String   @map("nama_bisnis")
  namaPemilik   String   @map("nama_pemilik")
  email         String
  noHp          String?  @map("no_hp")
  /// Aplikasi yang didaftar; formulir CafeOS selalu mengisi "CafeOS".
  jenisAplikasi String   @default("CafeOS") @map("jenis_aplikasi")
  pesan         String?
  /// Alur tindak lanjut admin: `baru` → `dihubungi` → `aktif`, atau `batal`.
  /// Sengaja TEXT, bukan enum: panel super admin menulis statusnya sebagai
  /// teks biasa, dan menambah label baru di sana tidak boleh menuntut migrasi
  /// tipe di aplikasi ini. Nilainya dijaga CHECK constraint yang dipasang di
  /// migrasi `20260825000000_tambah_tenant_registrations` — Prisma belum bisa
  /// menyatakan CHECK di schema, jadi jangan hapus saat `prisma migrate dev`.
  status        String   @default("baru")
  createdAt     DateTime @default(now()) @map("created_at")

  // Panel admin menyaring per status dan mengurutkan terbaru dulu.
  @@index([status])
  @@index([createdAt])
  @@map("tenant_registrations")
}

// ═══════════════════════════════════════════════════════════════════════════
// STAF, PERANGKAT, JADWAL, ABSENSI, DAN SHIFT KASIR
// ═══════════════════════════════════════════════════════════════════════════
//
// Tiga hal yang sering dikira satu, dan sengaja dipisah di sini:
//
//   JADWAL   (`shift_templates` + `shift_schedules`) — RENCANA. Siapa
//            seharusnya bekerja kapan. Ditulis pemilik, jauh sebelum harinya.
//   ABSENSI  (`attendance_records`) — KEHADIRAN. Siapa yang benar-benar
//            datang, jam berapa, dengan bukti foto. Urusan kepegawaian.
//   SHIFT    (`cashier_shifts`) — TANGGUNG JAWAB UANG. Siapa yang memegang
//            laci kas, sejak kapan, dengan modal berapa, dan berapa
//            selisihnya saat ditutup. Urusan keuangan.
//
// Seorang staf bisa hadir tanpa memegang kas (dapur), dan satu kehadiran bisa
// menaungi satu shift kas. Menyatukan ketiganya ke satu tabel — godaan yang
// besar karena ketiganya punya "jam mulai" dan "jam selesai" — membuat
// pertanyaan "berapa selisih kas Budi kemarin" dan "apakah Budi terlambat"
// terpaksa dijawab dari baris yang sama, padahal keduanya bisa berbeda: Budi
// bisa hadir tepat waktu lalu membuka laci satu jam kemudian.
//
// ── TIPE UANG ──
// Seluruh kolom uang DI BAWAH INI bertipe BIGINT rupiah bulat, bukan
// Decimal(12,2) seperti tabel-tabel lama. Rupiah tidak mengenal sen, dan
// pembulatan pecahan pada penjumlahan kas laci adalah cara paling sunyi untuk
// membuat "tunai seharusnya" meleset beberapa rupiah setiap hari. Tabel lama
// (`orders`, `payments`) SENGAJA tidak ikut diubah — mengubah tipe kolom yang
// sudah berisi data penjualan menuntut penguncian tabel, dan itu bukan harga
// yang pantas dibayar untuk keseragaman. Konversinya terpusat di
// `lib/rupiah.ts`, satu-satunya tempat kedua dunia itu bertemu.

// ── Jadwal kerja ─────────────────────────────────────────────────────────────

/// Pola shift yang berulang — "Pagi 07:00-15:00", "Malam 22:00-06:00".
///
/// Jamnya disimpan sebagai MENIT DARI TENGAH MALAM (0-1439), bukan teks
/// "HH:MM" maupun DateTime. Alasannya aritmetika: hampir setiap perhitungan di
/// modul ini adalah selisih menit (terlambat berapa lama, lembur berapa lama,
/// apakah jam ini masih di dalam shift), dan menit bulat membuat semuanya
/// menjadi pengurangan biasa — tanpa parsing teks, tanpa zona waktu yang ikut
/// terbawa pada tipe DateTime yang sebenarnya cuma ingin menyatakan "jam tujuh".
model ShiftTemplate {
  id     String @id @default(uuid()) @db.Uuid
  cafeId String @map("cafe_id") @db.Uuid
  nama   String

  /// Menit dari tengah malam, waktu KAFE (lihat `cafes.timezone`).
  menitMulai   Int @map("menit_mulai")
  menitSelesai Int @map("menit_selesai")

  /// Shift yang berakhir di hari berikutnya (mis. 22:00 sampai 06:00).
  ///
  /// Disimpan EKSPLISIT, tidak diturunkan dari `menitSelesai <= menitMulai`,
  /// karena turunan itu tidak bisa membedakan shift 24 jam (08:00 sampai 08:00
  /// keesokan harinya) dari shift berdurasi nol — dan yang pertama benar-benar
  /// dipakai kafe yang buka nonstop.
  lewatTengahMalam Boolean @default(false) @map("lewat_tengah_malam")

  /// Batas toleransi sebelum kehadiran dihitung TERLAMBAT.
  toleransiTerlambatMenit Int @default(10) @map("toleransi_terlambat_menit")

  /// Hari berlaku sebagai angka ISO 1-7 (1 = Senin sampai 7 = Minggu). Kosong =
  /// berlaku setiap hari. Sengaja BUKAN 0-6 ala JavaScript: batas hari di modul
  /// ini dihitung dengan kalender kafe, dan ISO adalah satu-satunya penomoran
  /// yang tidak berubah arti saat dipindahkan antar bahasa.
  hariBerlaku Int[] @default([]) @map("hari_berlaku")

  aktif   Boolean @default(true)
  urutan  Int     @default(0)
  catatan String?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  cafe      Cafe            @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  schedules ShiftSchedule[]
  shifts    CashierShift[]

  @@index([cafeId])
  @@index([cafeId, aktif])
  @@map("shift_templates")
}

/// Penugasan SATU staf pada SATU tanggal — hasil kali template x orang x hari.
///
/// `tanggal` adalah tanggal KALENDER KAFE tempat shift itu DIMULAI; shift yang
/// melewati tengah malam tetap tercatat pada tanggal mulainya, sehingga "jadwal
/// tanggal 5" berarti hal yang sama bagi pemilik dan bagi laporan.
model ShiftSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  cafeId     String   @map("cafe_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tanggal    DateTime @db.Date

  /// Terminal/laci yang direncanakan. Tidak mengikat — kasir boleh membuka
  /// shift di terminal lain bila yang ini rusak.
  deviceId String? @map("device_id") @db.Uuid

  /// DIJADWALKAN | DIBATALKAN. Teks, bukan enum — lihat catatan kosakata di
  /// `lib/orderStatus.ts`; alasannya sama persis.
  status  String  @default("DIJADWALKAN")
  catatan String?

  dibuatOleh String? @map("dibuat_oleh") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe        Cafe               @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  template    ShiftTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  user        User               @relation("JadwalStaf", fields: [userId], references: [id], onDelete: Cascade)
  device      CashierDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  attendances AttendanceRecord[]
  shifts      CashierShift[]
  penggantian ShiftReplacement[]

  /// Satu orang tidak dijadwalkan dua kali pada template & tanggal yang sama.
  /// Bentrok ANTAR template (dua shift yang jamnya bertumpang tindih) tidak
  /// bisa dinyatakan sebagai constraint — jamnya ada di tabel lain — jadi itu
  /// diperiksa service sebelum menulis.
  @@unique([cafeId, templateId, userId, tanggal])
  @@index([cafeId, tanggal])
  @@index([userId, tanggal])
  @@map("shift_schedules")
}

// ── Perangkat POS ────────────────────────────────────────────────────────────

/// Terminal kasir milik sebuah kafe — satu tablet/PC di satu meja kasir.
///
/// Yang disimpan hanya HASH token perangkatnya, sealasan dengan kata sandi:
/// database yang bocor tidak boleh langsung menjadi sekumpulan terminal yang
/// bisa dipakai orang lain. Token aslinya diperlihatkan SEKALI saat pendaftaran
/// dan sesudah itu tidak bisa dibaca ulang oleh siapa pun, termasuk pemilik.
model CashierDevice {
  id     String @id @default(uuid()) @db.Uuid
  cafeId String @map("cafe_id") @db.Uuid
  label  String

  /// SHA-256 token perangkat. Unik lintas sistem: satu token, satu terminal.
  tokenHash String @unique @map("token_hash")

  aktif           Boolean   @default(true)
  terakhirDipakai DateTime? @map("terakhir_dipakai")

  dicabutPada DateTime? @map("dicabut_pada")
  dicabutOleh String?   @map("dicabut_oleh") @db.Uuid
  dibuatOleh  String?   @map("dibuat_oleh") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe      Cafe            @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  schedules ShiftSchedule[]
  shifts    CashierShift[]

  @@index([cafeId])
  @@index([cafeId, aktif])
  @@map("cashier_devices")
}

// ── Absensi ──────────────────────────────────────────────────────────────────

/// Satu kehadiran: datang, (mungkin) pulang, beserta bukti fotonya.
///
/// Waktunya SELALU waktu server (`now()` saat permintaan diterima), tidak
/// pernah waktu yang dikirim perangkat. Jam tablet bisa diputar mundur oleh
/// siapa pun yang memegangnya, dan absensi yang bisa diputar mundur tidak
/// membuktikan apa pun. Waktu tangkapan lokal boleh ikut dicatat sebagai
/// keterangan tambahan (`diambilPada` di `attendance_photos`), tapi tidak
/// pernah menggantikan yang ini.
model AttendanceRecord {
  id         String  @id @default(uuid()) @db.Uuid
  cafeId     String  @map("cafe_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  scheduleId String? @map("schedule_id") @db.Uuid

  masukPada  DateTime? @map("masuk_pada")
  keluarPada DateTime? @map("keluar_pada")

  /// Kosakata di `lib/absensiStatus.ts`: SCHEDULED | PRESENT | LATE |
  /// PERMISSION | SICK | ABSENT | REPLACED | OVERTIME | EARLY_LEAVE | COMPLETED.
  status String @default("SCHEDULED")

  /// Hasil hitung terhadap jadwal, disimpan supaya laporan tidak perlu
  /// mengulang aritmetika kalender untuk tiap baris — dan supaya angka yang
  /// dilihat pemilik hari ini tetap sama setelah jadwalnya diubah besok.
  terlambatMenit Int? @map("terlambat_menit")
  lemburMenit    Int? @map("lembur_menit")
  durasiMenit    Int? @map("durasi_menit")

  deviceMasukId  String? @map("device_masuk_id") @db.Uuid
  deviceKeluarId String? @map("device_keluar_id") @db.Uuid

  /// Kamera gagal / perangkat tidak punya kamera. Wajib berpasangan dengan
  /// alasan, dan menunggu persetujuan pemilik — foto tidak pernah dilewati
  /// diam-diam.
  pengecualianFoto   Boolean   @default(false) @map("pengecualian_foto")
  alasanPengecualian String?   @map("alasan_pengecualian")
  disetujuiOleh      String?   @map("disetujui_oleh") @db.Uuid
  disetujuiPada      DateTime? @map("disetujui_pada")

  catatan       String?
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe     Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user     User              @relation("AbsensiStaf", fields: [userId], references: [id], onDelete: Cascade)
  schedule ShiftSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  photos   AttendancePhoto[]
  shifts   CashierShift[]

  @@index([cafeId, masukPada])
  @@index([userId, masukPada])
  @@index([cafeId, status])
  @@map("attendance_records")
}

/// Referensi foto absensi. Berkasnya di disk privat server, BUKAN di kolom ini.
///
/// Tabel terpisah dari `attendance_records` supaya masa simpan (retensi) bisa
/// dijalankan tanpa menyentuh catatan kehadirannya: foto tiga bulan lalu boleh
/// dihapus, sementara fakta bahwa orangnya hadir hari itu harus tetap ada
/// selamanya. Baris ini bertahan setelah berkasnya hilang — `dihapusPada`
/// menjadi jejak bahwa foto pernah ada dan sengaja dihapus, bukan hilang.
model AttendancePhoto {
  id           String @id @default(uuid()) @db.Uuid
  cafeId       String @map("cafe_id") @db.Uuid
  attendanceId String @map("attendance_id") @db.Uuid

  /// MASUK | KELUAR.
  jenis String

  /// Nama berkas acak di disk — tanpa nama asli dari klien, tanpa ekstensi
  /// ganda, dan tidak pernah dirangkai dari input pengguna. Itulah yang
  /// membuat path traversal tidak punya bahan untuk dikerjakan.
  namaBerkas String @map("nama_berkas")
  mimeType   String @map("mime_type")
  ukuranByte Int    @map("ukuran_byte")

  /// Waktu SERVER saat berkas diterima — inilah yang berlaku.
  diterimaPada DateTime @default(now()) @map("diterima_pada")

  /// Waktu yang DIKLAIM perangkat saat memotret. Keterangan tambahan untuk
  /// antrean offline; tidak pernah dipakai menghitung keterlambatan.
  diambilPada DateTime? @map("diambil_pada")

  /// Jarak antara keduanya melampaui ambang wajar, ditandai "Diunggah
  /// terlambat" di layar, bukan disembunyikan.
  terlambatDiunggah Boolean @default(false) @map("terlambat_diunggah")

  dihapusPada DateTime? @map("dihapus_pada")

  createdAt DateTime @default(now()) @map("created_at")

  cafe       Cafe             @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([cafeId, diterimaPada])
  @@map("attendance_photos")
}

// ── Shift kasir ──────────────────────────────────────────────────────────────

/// Satu periode tanggung jawab atas laci kas.
///
/// Inilah yang membuat pertanyaan "siapa yang memegang uang saat transaksi ini
/// terjadi" punya jawaban. Setiap pembayaran yang disentuh kasir menyimpan
/// `cashier_shift_id`, dan penutupan shift menjumlahkan persis transaksi yang
/// menunjuk ke sini — bukan "semua transaksi antara jam sekian dan jam sekian",
/// yang akan salah begitu dua terminal bekerja bersamaan.
model CashierShift {
  id           String  @id @default(uuid()) @db.Uuid
  cafeId       String  @map("cafe_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  attendanceId String? @map("attendance_id") @db.Uuid
  scheduleId   String? @map("schedule_id") @db.Uuid
  deviceId     String? @map("device_id") @db.Uuid
  templateId   String? @map("template_id") @db.Uuid

  /// Nama shift SAAT ITU (snapshot). Template boleh diganti nama besok;
  /// laporan bulan lalu tidak boleh ikut berubah karenanya.
  namaShift String @map("nama_shift")

  dibukaPada  DateTime  @default(now()) @map("dibuka_pada")
  ditutupPada DateTime? @map("ditutup_pada")

  /// AKTIF | DITUTUP.
  status String @default("AKTIF")

  // ── Uang (BIGINT rupiah — lihat catatan tipe uang di kepala bagian ini) ──
  modalAwal BigInt @default(0) @map("modal_awal")

  /// Diisi saat penutupan: yang benar-benar dihitung kasir di laci.
  kasAktual BigInt? @map("kas_aktual")

  /// Dihitung server saat penutupan, dibekukan di sini supaya rekap tidak
  /// berubah bila transaksi lama dikoreksi belakangan.
  kasSeharusnya BigInt? @map("kas_seharusnya")

  /// `kasAktual - kasSeharusnya`. Negatif = kurang, positif = lebih.
  selisih BigInt? @map("selisih")

  catatanBuka  String? @map("catatan_buka")
  catatanTutup String? @map("catatan_tutup")

  /// Koreksi pemilik atas shift yang sudah ditutup. Nilai lamanya TIDAK
  /// ditimpa diam-diam — perubahannya masuk audit log dengan alasannya.
  dikoreksiOleh String?   @map("dikoreksi_oleh") @db.Uuid
  dikoreksiPada DateTime? @map("dikoreksi_pada")
  alasanKoreksi String?   @map("alasan_koreksi")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe       Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user       User              @relation("ShiftKasir", fields: [userId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  schedule   ShiftSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  device     CashierDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  template   ShiftTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  movements  CashMovement[]
  orders     Order[]

  // CATATAN: "satu kasir hanya boleh punya satu shift AKTIF" dan "satu terminal
  // hanya boleh punya satu shift AKTIF" dipasang sebagai PARTIAL UNIQUE INDEX
  // (WHERE status = 'AKTIF') lewat SQL mentah di migrasi — Prisma belum bisa
  // menyatakan index parsial di schema. Constraint biasa tidak bisa dipakai:
  // ia akan melarang kasir yang sama membuka shift KEDUA besok pagi. Jangan
  // hapus index itu saat menjalankan `prisma migrate dev`.
  @@index([cafeId, dibukaPada])
  @@index([cafeId, status])
  @@index([userId, dibukaPada])
  @@map("cashier_shifts")
}

/// Uang yang masuk/keluar laci di luar penjualan — setoran awal tambahan,
/// pengambilan untuk belanja, penukaran uang kecil.
///
/// Tanpa tabel ini, setiap pengambilan uang dari laci akan muncul sebagai
/// "selisih kas" saat penutupan, dan selisih yang selalu ada berhenti menjadi
/// peringatan bagi siapa pun.
model CashMovement {
  id      String @id @default(uuid()) @db.Uuid
  cafeId  String @map("cafe_id") @db.Uuid
  shiftId String @map("shift_id") @db.Uuid

  /// MASUK | KELUAR.
  jenis   String
  nominal BigInt

  /// Wajib. Uang yang berpindah tanpa alasan tertulis tidak bisa
  /// dipertanggungjawabkan besok.
  alasan String

  actorUserId String? @map("actor_user_id") @db.Uuid

  disetujuiOleh String?   @map("disetujui_oleh") @db.Uuid
  disetujuiPada DateTime? @map("disetujui_pada")

  createdAt DateTime @default(now()) @map("created_at")

  cafe  Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  shift CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([cafeId, createdAt])
  @@map("cash_movements")
}

/// Permintaan menggantikan staf yang terjadwal.
///
/// Jadwalnya TIDAK diubah: `shift_schedules` tetap menyimpan siapa yang
/// seharusnya datang, dan baris ini menyimpan siapa yang benar-benar datang
/// beserta alasannya. Menimpa jadwal akan menghapus fakta bahwa penggantian
/// pernah terjadi — persis fakta yang ingin dilihat pemilik di laporan.
model ShiftReplacement {
  id         String @id @default(uuid()) @db.Uuid
  cafeId     String @map("cafe_id") @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid

  staffTerjadwalId String @map("staff_terjadwal_id") @db.Uuid
  staffPenggantiId String @map("staff_pengganti_id") @db.Uuid

  /// Wajib — pemilik menyetujui alasan, bukan sekadar nama.
  alasan String

  /// PENDING_APPROVAL | APPROVED | REJECTED.
  status String @default("PENDING_APPROVAL")

  diajukanPada    DateTime  @default(now()) @map("diajukan_pada")
  diputuskanOleh  String?   @map("diputuskan_oleh") @db.Uuid
  diputuskanPada  DateTime? @map("diputuskan_pada")
  alasanKeputusan String?   @map("alasan_keputusan")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cafe           Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  schedule       ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  staffTerjadwal User          @relation("PenggantiDigantikan", fields: [staffTerjadwalId], references: [id], onDelete: Cascade)
  staffPengganti User          @relation("PenggantiMenggantikan", fields: [staffPenggantiId], references: [id], onDelete: Cascade)

  @@index([cafeId, status])
  @@index([scheduleId])
  @@map("shift_replacements")
}
