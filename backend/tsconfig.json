{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*.ts"],
  // Berkas uji sengaja DIKELUARKAN dari build: hasilnya dikirim ke VPS,
  // dan tidak ada gunanya (juga tidak aman) mengirimkan tiruan Prisma ke
  // sana. Pemeriksaan tipenya tetap jalan lewat `tsconfig.test.json`.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test"]
}
