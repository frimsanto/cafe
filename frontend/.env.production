# Konfigurasi build produksi (VPS). Dipakai otomatis oleh `vite build`.
#
# Catatan: variabel berawalan VITE_ ikut ditanam ke dalam bundel JavaScript dan
# terlihat oleh siapa pun yang membuka situs — jadi jangan pernah menaruh
# rahasia (token, kunci privat) di berkas ini.

# Endpoint REST API — di-reverse-proxy ke Express backend.
VITE_API_URL=https://cafe.fessolution.my.id/cafe-api

# Endpoint WebSocket realtime — di-reverse-proxy ke path /ws pada backend.
VITE_WS_URL=wss://cafe.fessolution.my.id/cafe-ws
